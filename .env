# StockSense PostgreSQL Database Configuration
PORT=5001

# PostgreSQL Connection String
# Example: postgres://username:password@localhost:5432/stocksense
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense

# Or individual PG parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=stocksense
